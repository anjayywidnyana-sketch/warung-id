<!DOCTYPE html>
<html lang="id">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
<title><%= title %></title>
<link rel="stylesheet" href="/css/style.css">
<link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap" rel="stylesheet">
</head>
<body>
<div class="app-container">
<!-- Sidebar -->
<aside class="sidebar">
    <!-- Logo Website -->
    <div class="brand">
        <div class="brand-icon">W</div>
        <div class="brand-text">
            <h2>Warung <span>ID</span></h2>
            <small>INVENTORY SYSTEM</small>
        </div>
    </div>
    <!-- Menu -->
    <div class="sidebar-label">MENU UTAMA</div>
    <nav>
        <a href="/barang" class="nav-link active">
            <span class="nav-icon">▦</span>
            <span>Dashboard Barang</span>
        </a>
        <a href="/barang/tambah" class="nav-link">
            <span class="nav-icon">+</span>
            <span>Tambah Barang</span>
        </a>
    </nav>
    <!-- Informasi Pembuat -->
    <div class="sidebar-bottom">
        <div class="user-card">
            <div class="avatar">K</div>
            <div>
                <strong>Kelompok 2</strong>
                <small>Developer Website</small>
            </div>
        </div>
        <div class="creator-info">
            <small>DIBUAT OLEH</small>
            <strong>Kelompok 2</strong>
            <span>&copy; 2026 Warung ID</span>
        </div>
    </div>
</aside>
<!-- Konten Utama -->
<main class="main-content">
    <!-- Header Atas -->
    <header class="topbar">
        <div class="topbar-title">
            <span class="breadcrumb">Warung ID / Inventory</span>
            <h3>Manajemen Inventaris</h3>
        </div>
        <div class="admin-status">
            <span class="online-dot"></span>
            Sistem Aktif
        </div>
    </header>